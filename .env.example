# RockfallAI Root Environment Configuration
# Copy this file to backend/.env and frontend/.env respectively

# --- Backend Configuration (backend/.env) ---
PROJECT_NAME="AI-Based Multi-Modal Rockfall Risk Prediction and Early Warning System"
ENVIRONMENT=development
API_V1_PREFIX=/api
PORT=8000
HOST=0.0.0.0
DATABASE_URL=sqlite:///./data/rockfall_risk.db

# GenAI API Configuration (Anthropic Claude API preferred)
# If left blank, system automatically uses deterministic zero-key fallback
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
GENAI_PROVIDER=fallback

# Weather API Configuration (Optional - falls back to synthetic demo weather if not set)
OPENWEATHER_API_KEY=

# CORS Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# --- Frontend Configuration (frontend/.env) ---
VITE_API_BASE_URL=http://localhost:8000
